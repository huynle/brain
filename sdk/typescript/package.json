{
  "name": "@huynle/brain-sdk",
  "version": "0.1.0",
  "description": "Typed Brain HTTP client; server-side script execution is separately gated",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "generate": "openapi-typescript ../../api/openapi.yaml -o src/schema.gen.ts",
    "validate": "redocly lint ../../api/openapi.yaml --config redocly.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "2.58.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
